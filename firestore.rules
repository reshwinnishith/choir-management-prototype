rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // MODEL (v1.8C)
    //   users/{uid}                                  personal profile (self only)
    //   users/{uid}/memberships/{workspaceId}        self-owned "my workspaces" HINT list
    //   workspaces/{ws}                              choir workspace
    //   workspaces/{ws}/members/{uid}                authoritative membership + role
    //   workspaces/{ws}/{people|clients|...}/{id}    choir data
    //   invites/{code}                               one-time manager invite
    //
    // Two workspace generations coexist during the transition:
    //   MEMBERS workspaces  accessModel == 'members'  -> access via members/{uid} only
    //   LEGACY  workspaces  no accessModel field      -> ownerUid grants operational
    //                                                    access (TECHNICAL fallback; it is
    //                                                    NOT a role and never shown as ownership)
    // Removal plan: once every workspace has been migrated by the admin migration
    // script (accessModel set, ownerUid nulled), delete legacyAccess() and the
    // legacy branches below. Clients cannot flip a workspace to 'members'.
    // ------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function wsPath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }

    function memberPath(workspaceId, uid) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid);
    }

    function isActiveMember(workspaceId) {
      return isAuthenticated()
        && exists(memberPath(workspaceId, request.auth.uid))
        && get(memberPath(workspaceId, request.auth.uid)).data.status == 'active'
        && get(memberPath(workspaceId, request.auth.uid)).data.role in ['owner', 'manager'];
    }

    function isActiveOwner(workspaceId) {
      return isActiveMember(workspaceId)
        && get(memberPath(workspaceId, request.auth.uid)).data.role == 'owner';
    }

    // TECHNICAL legacy fallback: pre-v1.8C workspaces (no accessModel) keep working
    // for their original creator uid until migrated.
    function legacyAccess(workspaceId) {
      return isAuthenticated()
        && exists(wsPath(workspaceId))
        && get(wsPath(workspaceId)).data.get('accessModel', null) == null
        && get(wsPath(workspaceId)).data.get('ownerUid', null) == request.auth.uid;
    }

    function canOperate(workspaceId) {
      return isActiveMember(workspaceId) || legacyAccess(workspaceId);
    }

    function inviteIsFresh(invite) {
      return invite.status == 'active' && invite.expiresAt > request.time;
    }

    // ---------------- PERSONAL PROFILE ----------------
    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId);
      allow delete: if false;

      // "My workspaces" hint list. Real access is always decided by members/{uid};
      // a forged hint grants nothing, but we still require it to mirror a real membership.
      match /memberships/{workspaceId} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && getAfter(memberPath(workspaceId, userId)).data.role == request.resource.data.role
          && getAfter(memberPath(workspaceId, userId)).data.status == 'active';
        allow delete: if isSelf(userId);
      }
    }

    // ---------------- WORKSPACE ----------------
    match /workspaces/{workspaceId} {
      // Brand-new workspaces are membership-native: creator is Owner, and the
      // owner member doc must be created in the SAME batch.
      allow create: if isAuthenticated()
        && request.resource.data.accessModel == 'members'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && getAfter(memberPath(workspaceId, request.auth.uid)).data.role == 'owner'
        && getAfter(memberPath(workspaceId, request.auth.uid)).data.status == 'active';

      allow read: if canOperate(workspaceId);

      allow update: if isAuthenticated() && (
        // legacy owner: unchanged behavior, cannot self-upgrade to members model
        (legacyAccess(workspaceId)
          && request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null)
          && request.resource.data.get('accessModel', null) == null)
        // owner/manager: rename only
        || (isActiveMember(workspaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']))
        // future Owner account linking (ELFE: ownerUid null -> Roe's uid) via an owner invite
        || (resource.data.get('accessModel', null) == 'members'
          && resource.data.get('ownerUid', null) == null
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'updatedAt'])
          && getAfter(memberPath(workspaceId, request.auth.uid)).data.role == 'owner')
      );
      allow delete: if false;

      // ---------------- MEMBERS ----------------
      match /members/{memberUid} {
        // Any active member can see the team list (name/role only; no email stored here).
        allow read: if isActiveMember(workspaceId) || isSelf(memberUid);

        allow create: if isSelf(memberUid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'active'
          && (
            // (a) creator of a brand-new members workspace becomes Owner
            (request.resource.data.role == 'owner'
              && !exists(wsPath(workspaceId))
              && getAfter(wsPath(workspaceId)).data.ownerUid == request.auth.uid
              && getAfter(wsPath(workspaceId)).data.accessModel == 'members')
            // (b) join by valid one-time invite; role comes from the invite, never the user
            || (request.resource.data.inviteId is string
              && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId))
              && inviteIsFresh(get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data)
              && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.workspaceId == workspaceId
              && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.role == request.resource.data.role
              && request.resource.data.invitedByUid == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.createdByUid
              && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.status == 'used'
              && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.usedByUid == request.auth.uid)
          );

        // Roles/status are immutable from clients. A member may only edit their own display name.
        allow update: if isSelf(memberUid)
          && isActiveMember(workspaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']);

        // Owner can remove a Manager; a Manager can leave. Nobody removes an Owner.
        allow delete: if resource.data.role == 'manager'
          && (isActiveOwner(workspaceId) || isSelf(memberUid));
      }

      // ---------------- CHOIR DATA ----------------
      match /{subcollection}/{docId} {
        // 'members' is governed ONLY by the members rules above (rules are additive,
        // so this wildcard must never match it).
        allow read, write: if subcollection != 'members' && canOperate(workspaceId);
      }
    }

    // ---------------- INVITES ----------------
    // Doc id == the secret code. Possession of the code is the capability.
    // Owner-role invites cannot be created by clients (admin SDK only).
    match /invites/{inviteId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && isActiveMember(resource.data.workspaceId);

      allow create: if isAuthenticated()
        && isActiveMember(request.resource.data.workspaceId)
        && request.resource.data.role == 'manager'
        && request.resource.data.status == 'active'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'd')
        && !('usedByUid' in request.resource.data);

      // consume: active -> used, only by the consuming user, only these fields;
      // must come with the matching membership in the same batch.
      // revoke: an active member of the workspace cancels an unused invite.
      allow update: if isAuthenticated() && (
        (inviteIsFresh(resource.data)
          && request.resource.data.status == 'used'
          && request.resource.data.usedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedByUid', 'usedAt'])
          && getAfter(memberPath(resource.data.workspaceId, request.auth.uid)).data.role == resource.data.role)
        || (resource.data.status == 'active'
          && isActiveMember(resource.data.workspaceId)
          && request.resource.data.status == 'revoked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedByUid', 'revokedAt']))
      );

      allow delete: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
